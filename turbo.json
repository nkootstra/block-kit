{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "package.json",
    "bun.lock",
    "tsconfig.base.json",
    "fixtures/**/*.actions.json",
    "fixtures/**/*.probe.json",
    "fixtures/assets/samples/**",
    "fixtures/message/deploy-approval.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    }
  }
}
