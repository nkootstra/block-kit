{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import", "vitest", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-cycle": "off",
    "no-underscore-dangle": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.turbo/**",
    "**/*.generated.ts",
    "fixtures/**",
    "apps/docs/.blume/**"
  ]
}
