# A bot token with users:read, channels:read, usergroups:read and files:read.
# Leave it empty to run against the example's in-memory workspace instead.
SLACK_BOT_TOKEN=

# Where button clicks go: your app's Slack request URL (e.g. a Bolt app's
# http://localhost:3000/slack/events) and the signing secret it verifies requests with. Server
# only: never give these a VITE_ prefix. Leave both empty to send clicks to the demo app in this
# server, which uses a secret made up at startup.
SLACK_REQUEST_URL=
SLACK_SIGNING_SECRET=

# A development secret the page sends to the relays. Not a Slack credential, and not access
# control either: the page carries it, so anyone who can load the page can read it. It keeps out
# requests from clients that never loaded your page. Leave it empty for no token. Behind a tunnel,
# a preview or a shared network, put the whole example behind real authentication as well.
VITE_SLACK_RELAY_TOKEN=
