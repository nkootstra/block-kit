# A bot token with users:read, channels:read, usergroups:read and files:read.
# Leave it empty to run against the example's in-memory workspace instead.
SLACK_BOT_TOKEN=

# Where the Slack Web API lives. Leave it empty for slack.com; GovSlack is https://slack-gov.com/api/.
SLACK_API_URL=

# A development secret the page sends to the resolver relay. Not a Slack credential, so it can be
# public. Set it whenever the example is reachable beyond your machine (a tunnel, a preview, a
# shared network).
VITE_SLACK_RELAY_TOKEN=
