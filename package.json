{
  "name": "block-kit-monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*",
    "!tools/deploy",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "compare": "bun tools/visual/src/compare.ts",
    "compare:check": "bun tools/visual/src/compare.ts --check",
    "references:check": "bun tools/visual/src/references.ts --check",
    "coverage:visual": "bun tools/visual/src/coverage.ts",
    "emoji": "bun tools/emoji-data/generate.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.3",
    "emoji-datasource": "16.0.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "turbo": "2.11.13",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  },
  "overrides": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@scalar/json-magic>undici": "7.29.1",
    "@vercel/routing-utils>path-to-regexp": "6.3.0",
    "lodash-es": "4.18.1"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "blume@2.2.7": "patches/blume@2.2.7.patch"
  }
}
