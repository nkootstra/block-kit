# Every response. The pages run their own scripts only: the bundles from /_astro/ and the inline
# scripts the built pages carry (the theme script, Astro's island loader and the page's own),
# allowed by hash. The build (astro.config.mjs) fails when a built page's inline scripts don't match
# these hashes, and prints the ones it needs. Styles stay 'unsafe-inline': the package sets inline
# styles. Images may come from anywhere over https (a message shows whatever images its payload
# names, and emoji come from cdn.jsdelivr.net), or be data: and blob: URLs. Fonts are self-hosted.
# Nothing frames the page. The referrer is kept to the origin, so the projects the page links to
# (GitHub, npm) still see where visitors came from.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-Avkh/sVyGYf8dPcxBurnBSVmM6b6aNLkDbbKZw026V0=' 'sha256-1BvDVWLr3QCC20uHhUDi27eDFVJpk1uMQJGIWKUks2I=' 'sha256-xKBggZ2csD5Lp4tQr9izOLUTCZc1Nf4gged/rUHQ2+Y=' 'sha256-1D/eIB9sn/SpAyC7UTNveMJTrXy9xQcABsiipNoO9mQ=' 'sha256-Y8eHNKOkum9946FWxcgT/hj4GlaaqDz/U0SHJbPJlNQ='; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()
  X-Frame-Options: DENY

# Astro hashes the names of everything in /_astro/, so a file there never changes: cache it for a
# year. Pages keep the default (revalidate every visit), so a deploy shows up at once.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
