# OG Kit (ogkit.dev) renders the page's social card from its <template data-og-template>.
# Public and locked to block-kit.dev: it ships inside the og:image URL. Unset (local builds, pull
# requests), the page uses the static public/og.png instead.
OGKIT_API_KEY=
# Bump after editing the card's template, so already-shared links get the new image.
OGKIT_CACHE_VERSION=v1
