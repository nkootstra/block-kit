// Serves the static `blume build` output from Workers Static Assets, which also reads the
// `_headers` and `_redirects` files the build writes. Page routes and the docs API run
// `worker/index.ts` first, which answers agents with Markdown or JSON (pages and 404s) and gives
// Markdown copies (`.md`, `.mdx`) a canonical link; build assets and other raw files skip the
// Worker.
{
  "name": "block-kit-docs",
  "compatibility_date": "2026-09-28",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Serve `/blocks/section` directly instead of redirecting to `/blocks/section/`, so the URLs
    // Blume writes into the sitemap and canonical links don't redirect.
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/og/*",
      "!/.well-known/*",
      "!/*.txt",
      "!/*.xml",
      "!/*.png",
      "!/*.svg",
    ],
  },
  // `docs.block-kit.dev` is the docs' domain. The old `block-kit.kootstra.io` stays routed to the
  // Worker, which redirects every request on it to the same URL on the new domain.
  "routes": [
    { "pattern": "docs.block-kit.dev", "custom_domain": true },
    { "pattern": "block-kit.kootstra.io", "custom_domain": true },
  ],
  // Pull requests get a Preview (`wrangler preview`, see .github/workflows/docs-preview.yml) on a
  // workers.dev URL, which the Worker marks noindex.
  "preview_urls": true,
  "previews": { "vars": { "ROBOTS": "noindex" } },
}
