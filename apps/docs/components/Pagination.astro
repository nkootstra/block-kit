---
// Blume's prev/next footer, with one change on release pages: the changelog lists releases newest
// first, so Blume's "Previous" link points at the newer release and "Next" at the older one. The
// labels say which is which instead. Registered in components.ts.
import BlumePagination from "blume/components/layout/Pagination.astro";
import type { UIStrings } from "blume/core/i18n-ui.ts";

interface FlatPage {
  label: string;
  route: string;
}

interface Props {
  next: FlatPage | null;
  prev: FlatPage | null;
  strings: UIStrings["page"];
}

const { prev, next, strings } = Astro.props;
const neighbours = [prev, next].filter((page) => page !== null);
const releases =
  neighbours.length > 0 && neighbours.every((page) => page.route.startsWith("/changelog/"));
const labels = releases ? { ...strings, next: "Older release", previous: "Newer release" } : strings;
---

<BlumePagination next={next} prev={prev} strings={labels} />
