{
  "name": "@nkootstra/block-kit",
  "version": "0.0.0",
  "description": "Render Slack Block Kit JSON in React, pixel-for-pixel the way Slack does.",
  "keywords": [
    "block-kit",
    "blocks",
    "mrkdwn",
    "react",
    "renderer",
    "slack"
  ],
  "license": "MIT",
  "author": "Niels Kootstra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkootstra/block-kit.git",
    "directory": "packages/block-kit"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./mrkdwn": "./dist/mrkdwn.js",
    "./transport": "./dist/transport.js",
    "./server": "./dist/server.js",
    "./web-api": "./dist/web-api.js",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@slack/types": "3.1.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0"
  },
  "devDependencies": {
    "@slack/bolt": "^5.1.0",
    "@slack/web-api": "^8.1.1",
    "@testing-library/react": "16.3.3",
    "@types/mdast": "^4.0.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.1",
    "tsdown": "0.23.0"
  },
  "peerDependencies": {
    "@slack/web-api": ">=8.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "peerDependenciesMeta": {
    "@slack/web-api": {
      "optional": true
    }
  }
}
